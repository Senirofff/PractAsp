@model IEnumerable<АспЛекция3.Models.CartItem>
@{
    ViewData["Title"] = "Корзина";
    var products = ViewBag.Products as List<АспЛекция3.Models.Product>;
    int discount = ViewBag.UserDiscount ?? 0;
    decimal totalOriginal = 0;
    decimal totalDiscounted = 0;
}

<h2>@ViewData["Title"]</h2>

@if (discount > 0)
{
    <div class="alert alert-success">
        🎉 Ваша персональная скидка: <strong>@discount%</strong>
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Товар</th>
            <th>Цена</th>
            <th>Кол-во</th>
            <th>Итого</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var product = products?.FirstOrDefault(p => p.IdProduct == item.IdProduct);
            if (product == null) continue;

            decimal originalLine = product.Price * item.Quantity;
            decimal discountedLine = originalLine * (1 - discount / 100m);

            totalOriginal += originalLine;
            totalDiscounted += discountedLine;

            <tr>
                <td>@product.Name</td>
                <td>
                    @product.Price.ToString("0.00") ₽
                    @if (discount > 0)
                    {
                        <br />
                
                        <small class="text-success">
                            @((product.Price * (1 - discount / 100m)).ToString("0.00")) ₽
                        </small>
                    }
                </td>
                <td>
                    <form asp-action="UpdateQuantity" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.IdCartItem" />
                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control d-inline" style="width:70px" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">OK</button>
                    </form>
                </td>
                <td>
                    <strong>@discountedLine.ToString("0.00") ₽</strong>
                    @if (discount > 0)
                    {
                        <br />
                
                        <small class="text-muted text-decoration-line-through">@originalLine.ToString("0.00") ₽</small>
                    }
                </td>
                <td>
                    <form asp-action="RemoveFromCart" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.IdCartItem" />
                        <button type="submit" class="btn btn-sm btn-danger">🗑️</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end"><strong>Итого:</strong></td>
            <td>
                <strong>@totalDiscounted.ToString("0.00") ₽</strong>
                @if (discount > 0)
                {
                    <br />
                
                    <small class="text-muted text-decoration-line-through">@totalOriginal.ToString("0.00") ₽</small>
                }
            </td>
            <td></td>
        </tr>
    </tfoot>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Продолжить покупки</a>
    <form asp-controller="Order" asp-action="Checkout" method="post" class="d-inline ms-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success">
            <i class="fas fa-credit-card me-1"></i>Оформить заказ
        </button>
    </form>
</div>