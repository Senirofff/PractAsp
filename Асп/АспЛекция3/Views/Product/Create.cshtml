@model АспЛекция3.Models.Product

@{
    ViewData["Title"] = "Добавить товар";
}

<h2>Добавить новый товар</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Название товара</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Цена</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IdCategory" class="form-label">Категория</label>
                <select asp-for="IdCategory" class="form-select">
                    <option value="">-- Выберите категорию --</option>
                    @foreach (var item in (List<АспЛекция3.Models.Category>)ViewBag.Categories)
                    {
                        <option value="@item.IdCategory">@item.Name</option>
                    }
                </select>
                <span asp-validation-for="IdCategory" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="DosageForm" class="form-label">Форма выпуска</label>
                    <input asp-for="DosageForm" class="form-control" placeholder="Таблетки, сироп..." />
                </div>
                <div class="col-md-6">
                    <label asp-for="Dosage" class="form-label">Дозировка</label>
                    <input asp-for="Dosage" class="form-control" placeholder="500 мг, 10 мл..." />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ExpirationDate" class="form-label">Срок годности</label>
                <input asp-for="ExpirationDate" class="form-control" type="date" />
                <span asp-validation-for="ExpirationDate" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RequiresPrescription" class="form-check-input" type="checkbox" />
                <label asp-for="RequiresPrescription" class="form-check-label">Требуется рецепт</label>
            </div>

            <div class="mb-3">
                <label asp-for="Discription" class="form-label">Описание</label>
                <textarea asp-for="Discription" class="form-control" rows="3"></textarea>
            </div>

            <button type="submit" class="btn btn-success">Создать</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}