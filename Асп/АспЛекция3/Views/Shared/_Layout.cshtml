<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Аптека P824</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        body {
            background-color: #2F4F4F;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #2c3e50;
            color: #ecf0f1;
            padding-top: 20px;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        }

        .nav-link {
            color: #bdc3c7 !important;
            padding: 12px 20px;
            transition: all 0.3s ease;
        }

            .nav-link:hover,
            .nav-link.active {
                background-color: #34495e;
                color: white !important;
            }

        .main-content {
            background-color: #A9A9A9;
            min-height: 100vh;
            padding: 30px;
        }

        .card {
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            border: none;
        }

        .sidebar h4 {
            color: #ecf0f1;
            font-weight: 600;
        }

        .text-muted {
            color: #95a5a6 !important;
        }

        .user-panel {
            background-color: #34495e;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .logout-btn {
            background-color: #e74c3c;
            border: none;
            color: white;
            padding: 8px 15px;
            border-radius: 5px;
            transition: all 0.3s;
        }

            .logout-btn:hover {
                background-color: #c0392b;
                color: white;
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Боковая панель -->
            <div class="col-md-3 col-lg-2 sidebar">
                <div class="px-3 mb-4 text-center">
                    <h4><i class="fas fa-pills text-primary"></i> Аптека P824</h4>
                    <p class="text-muted small mb-0">Административная панель</p>
                </div>

                <!-- 🔹 Панель пользователя (если авторизован) -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Неизвестно";
                    <div class="user-panel mx-3 mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fas fa-user-circle fa-2x me-2 text-primary"></i>
                            <div>
                                <div class="fw-bold text-white">@User.Identity.Name</div>
                                <small class="text-muted">@role</small>
                            </div>
                        </div>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn logout-btn w-100">
                                <i class="fas fa-sign-out-alt me-2"></i>Выйти
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="mx-3 mb-3">
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light w-100 mb-2">
                            <i class="fas fa-sign-in-alt me-2"></i>Войти
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-light w-100">
                            <i class="fas fa-user-plus me-2"></i>Регистрация
                        </a>
                    </div>
                }

                <!-- Навигация -->
                <nav class="nav flex-column">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home me-2"></i> Главная
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" &&
                                                                                            ViewContext.RouteData.Values["action"]?.ToString() != "Cart" ? "active" : "")"
                       asp-controller="Product" asp-action="Index">
                        <i class="fas fa-boxes me-2"></i> Товары
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" &&
                                                                                            ViewContext.RouteData.Values["action"]?.ToString() == "Cart" ? "active" : "")"
                       asp-controller="Product" asp-action="Cart">
                        <i class="fas fa-shopping-cart me-2"></i> Корзина
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")"
                       asp-controller="Order" asp-action="Index">
                        <i class="fas fa-shopping-bag me-2"></i> Заказы
                    </a>

                    <!-- 🔹 Разделитель для админ-панели -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <hr class="border-secondary my-3" />
                        <small class="text-muted px-3">АДМИНИСТРИРОВАНИЕ</small>

                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")"
                           asp-controller="Category" asp-action="Index">
                            <i class="fas fa-tags me-2"></i> Категории
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")"
                           asp-controller="User" asp-action="Index">
                            <i class="fas fa-users me-2"></i> Пользователи
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Role" ? "active" : "")"
                           asp-controller="Role" asp-action="Index">
                            <i class="fas fa-user-shield me-2"></i> Роли
                        </a>
                    }
                </nav>
            </div>

            <!-- Основной контент -->
            <div class="col-md-9 col-lg-10 main-content">
                <!-- 🔹 Сообщения об успехе/ошибке -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <ul class="mb-0">
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                @foreach (var error in modelState.Errors)
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>