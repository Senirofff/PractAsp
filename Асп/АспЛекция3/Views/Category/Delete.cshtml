@model АспЛекция3.Models.Category

<h2 class="text-danger">Удаление категории</h2>

<div class="alert alert-warning">
    <h4>Вы уверены, что хотите удалить эту категорию?</h4>
    <p><strong>@Model.Name</strong></p>
    <small class="text-muted">ID: @Model.IdCategory</small>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdCategory" />
    <button type="submit" class="btn btn-danger">Да, удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>