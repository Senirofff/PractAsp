@model АспЛекция3.Models.User

@{
    ViewData["Title"] = "Добавить пользователя";
}

<h2>@ViewData["Title"]</h2>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="Create">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Login" class="form-label"></label>
                <input asp-for="Login" class="form-control" />
                <span asp-validation-for="Login" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="PasswordHash" class="form-label"></label>
                <input asp-for="PasswordHash" type="password" class="form-control" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="MiddleName" class="form-label"></label>
                <input asp-for="MiddleName" class="form-control" />
                <span asp-validation-for="MiddleName" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" placeholder="+7(999)123-45-67" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="IdRole" class="form-label"></label>
        <select asp-for="IdRole" class="form-control">
            @foreach (var role in ViewBag.Roles as IEnumerable<АспЛекция3.Models.Role> ?? Enumerable.Empty<АспЛекция3.Models.Role>())
            {
                <option value="@role.IdRole">@role.Title</option>
            }
        </select>
        <span asp-validation-for="IdRole" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Добавить пользователя</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>