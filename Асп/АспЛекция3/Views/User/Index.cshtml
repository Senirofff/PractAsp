@model IEnumerable<АспЛекция3.Models.User>

@{
    ViewData["Title"] = "Пользователи системы";
}

<h2>Пользователи системы</h2>

<p>
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus"></i> Добавить пользователя
    </a>
</p>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Логин</th>
            <th>Фамилия</th>
            <th>Имя</th>
            <th>Отчество</th>
            <th>Телефон</th>
            <th>Email</th>
            <th>Роль</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdUser</td>
                <td>@item.Login</td>
                <td>@item.LastName</td>
                <td>@item.FirstName</td>
                <td>@item.MiddleName</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.IdRole</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdUser" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i> Изменить
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.IdUser" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash"></i> Удалить
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Пользователей пока нет</p>
}