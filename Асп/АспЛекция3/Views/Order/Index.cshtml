@model IEnumerable<АспЛекция3.Models.Order>

<h2>Список заказов</h2>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>№ Заказа</th>
            <th>Дата</th>
            <th>ID Пользователя</th>
            <th>Статус</th>
            <th>Сумма</th>
            <th>Адрес доставки</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>№@item.IdOrder</strong></td>
                <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.IdUser</td>
                <td>
                    <span class="badge bg-@(item.Status == "Новый" ? "primary" : item.Status == "Выполнен" ? "success" : "warning")">
                        @item.Status
                    </span>
                </td>
                <td><strong>@item.TotalAmount.ToString("N2") руб.</strong></td>
                <td style="max-width: 300px;">@item.DeliveryAddress</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdOrder" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i> Подробнее
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.IdOrder" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash"></i> Удалить
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Заказов пока нет</p>
}